{
  "$schema": "https://opencode.ai/config.json",
  "model": "openhands/claude-sonnet-4-5-20250929",
  "provider": {
    "openhands": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenHands LLM Proxy",
      "options": {
