{
  "$schema": "https://opencode.ai/config.json",
  "model": "openhands/glm-5.2",
  "provider": {
    "openhands": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenHands LLM Proxy",
      "options": {
        "baseURL": "{env:ODSC_LLM_BASE_URL}",
        "apiKey": "{env:LLM_API_KEY}"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    }
  }
}
