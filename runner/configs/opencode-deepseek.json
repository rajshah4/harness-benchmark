{
  "$schema": "https://opencode.ai/config.json",
  "model": "openhands/deepseek-v4-pro",
  "provider": {
    "openhands": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenHands LLM Proxy",
      "options": {
        "baseURL": "{env:ODSC_LLM_BASE_URL}",
        "apiKey": "{env:LLM_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        }
      }
    }
  }
}
